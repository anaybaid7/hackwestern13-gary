# Settings for start_gary.sh. Copy this file to gary.env and edit it.
# gary.env is not tracked by git.

# The backend's address. Leave it empty and nothing is uploaded: Gary still
# works and keeps everything in journal.jsonl until sync runs.
GARY_API=

# Flags for Gary himself. --mute: no speaker (the buzzer carries the feedback).
# For the QNX numbers add --priority 20.
GARY_FLAGS="--mute"

# on: play Gary's sound clips through a speaker too (a USB speaker on the Pi).
# Test the speaker first: mmrplay sounds/quest.wav (QNX) or aplay (Linux).
GARY_SOUND=off

# GPIO numbers of the button and the buzzer. "none" switches one off.
# With a Grove Base HAT use its socket numbers, for example 5 and 16.
GARY_BUTTON_PIN=17
GARY_BUZZER_PIN=27

# Extra flags for gary_io.py, for example --active-low or --tones.
GARY_IO_FLAGS=""
