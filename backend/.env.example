# Copy to backend/.env (not tracked by git). Every line is optional.

# Postgres on Tiger Data. Unset: everything is kept in memory.
# Tiger Console > your service > Connect gives this string.
# DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# If set, the scout must send it (X-Scout-Key) to post quests.
# SCOUT_KEY=

# If set, POST /api/dev/reset must send it (X-Admin-Key).
# GARY_ADMIN_KEY=

# A passphrase for the private side (check-ins and the wellness view). If set,
# the page asks for it once per device. Without it, anyone who has the
# address can read the check-ins, and the page says so.
# GARY_PRIVATE_KEY=

# Quiet time before Gary naps. 8 hours by default. A short value such as 60
# lets you see a nap and a welcome back within minutes. Leave it out for the
# three-minute demo in docs/DEMO.md: Gary would be asleep again before the end.
# GARY_NAP_SECONDS=60

# TinyFish, for picks for you (POST /api/picks): an agent reads live pages
# with what Gary knows about you. Unset here: the key in scout/.env is used.
# Unset in both: /api/picks says TinyFish is not set up. Nothing else changes.
# TINYFISH_API_KEY=
# Seconds one live page may take for picks (default 150).
# GARY_PICKS_WAIT=150

# Where days and weeks turn over.
# GARY_TZ=America/Toronto
